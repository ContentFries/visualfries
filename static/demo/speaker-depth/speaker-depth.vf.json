{
	"size": [
		1080,
		1920
	],
	"fps": 30,
	"background": "#08090c",
	"transcript": "talk.transcript.json",
	"fonts": [
		{
			"family": "Anton",
			"src": "fonts/Anton-Regular.ttf"
		},
		{
			"family": "Inter",
			"src": "fonts/Inter.ttf",
			"weight": "100 900"
		}
	],
	"footage": {
		"talk": {
			"src": "talk.mp4",
			"matte": "talk.matte.mp4"
		}
	},
	"clips": [
