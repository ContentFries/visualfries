					"occurrence": 1
				},
				"ai": {
					"say": "AI",
					"occurrence": 1
				},
				"other": "compared to",
				"without": "doesn't use them",
				"so": "so clearly",
				"huge": "huge",
				"lead": "edge",
				"but": "But we're",
				"far": "far from",
				"ai2": {
					"say": "AI",
					"occurrence": 2
				},
				"fully": "fully",
				"replace": "replace it"
			},
			"words": {
				"captions": "clip"
			}
