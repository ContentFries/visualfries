// visualfries.com: the prerendered SvelteKit site in build/, served as Workers static assets.
// worker/index.js runs first on every request so the bare domain can redirect to www.
// Deploy: `pnpm build && npx wrangler deploy`
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "visualfries-site",
	"compatibility_date": "2026-09-01",
	"main": "worker/index.js",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"run_worker_first": true,
		// build/404.html is a real prerendered page; serve it with status 404
		"not_found_handling": "404-page",
		// /docs/install -> build/docs/install.html, matching trailingSlash = 'never'
		"html_handling": "drop-trailing-slash"
	},
	"routes": [
		{ "pattern": "visualfries.com", "custom_domain": true },
		{ "pattern": "www.visualfries.com", "custom_domain": true }
	]
}
